# 开发/演练栈的环境变量。复制成 .env 后按需修改；.env 已被 gitignore。
# 内核 API 凭据（面板与 shell 都用它）：自选一串随机字符
DEV_API_SECRET=change-me-dev-secret

# 端口一律用 127.0.0.1 高位端口，避免与生产栈冲突
DEV_API_PORT=19090
DEV_MIXED_PORT=17897
DEV_PANEL_PORT=19091
MIHOMO_BRIDGE_SUBNET=172.30.197.0/24
MIHOMO_BRIDGE_GATEWAY=172.30.197.1
# 覆盖默认 CIDR 时，若需从宿主访问 mixed 端口，应包含网桥网关 /32。
# MIHOMO_LAN_ALLOWED_IPS=127.0.0.0/8,172.30.197.1/32
# ZASHBOARD_CONTEXT=../zashboard-autofallback
SUBSCRIPTION_CACHE_MAX_AGE=86400

# 内核镜像来源（默认上游；用本机构建的同版本镜像时改这两个）
CORE_IMAGE=metacubex/mihomo:v1.19.33
CORE_BIN=/mihomo
# CORE_IMAGE=mihomo:1.19.33
# CORE_BIN=/usr/local/bin/mihomo

# 刷新与评分
REFRESH_INTERVAL=21600
MIHOMO_SCORES_MAX_AGE=43200
PREFER_REGION=jp
PREFER_BONUS=5
SCORE_PLATFORMS=all
SCORE_SAMPLES=2
KEEP_FAILURE=0

# 规则层：curated 规则集（rules/henrychiao.yaml，配置里已定路径）
# SUB_RULES=1 表示保留机场订阅自带的规则（默认 0 = 只用 curated 规则）
MIHOMO_SUB_RULES=0

# 巡检与纯净度
WATCHDOG_INTERVAL=300          # 选中节点的巡检周期（秒）
PURITY_ENABLED=1               # 每次完整事务前测各节点真实出口 IP
PURITY_PACE=1.2                # 直连情报查询的最小间隔（ip-api 免费额度 45 次/分）
MIHOMO_PURITY_WEIGHT=0.10      # 纯净度在总分中的权重（其余平台按比例让出）

# 定向站点组（可选）：某些站点会按出口 IP 在 TLS 层拒绝，需要单独探测。
# 域名与探针地址必须成对出现；留空则不生成该组。示例使用占位域名。
MIHOMO_SITE_GROUP=Site出口
MIHOMO_SITE_DOMAINS=
# MIHOMO_SITE_DOMAINS=panel.example.com
# MIHOMO_SITE_HEALTH_URL=https://panel.example.com/
MIHOMO_SITE_HEALTH_STATUS=200

TZ=Asia/Shanghai
